# This is Git's per-user configuration file.
[user]
	name = uzimaru0000
	email = shuji365630@gmail.com
	signingkey = 882B66540430C749
[core]
	editor = nvim
	pager = delta
	compression = 0
	excludesfile = /Users/uzimaru/.gitignore_global
[alias]
	ignore = "!gi() { curl -sL https://www.toptal.com/developers/gitignore/api/$@ ;}; gi"
[rerere]
	enabled = true
[interactive]
	diffFilter = delta --color-only
[delta]
	syntax-theme = Nord

[http]
	postBuffer = 500M
	maxRequestBuffer = 100M
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[gpg]
	program = /opt/homebrew/bin/gpg
[init]
	defaultBranch = main
