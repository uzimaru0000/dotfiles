# This is Git's per-user configuration file.
[user]
	name = uzimaru0000
	email = shuji365630@gmail.com
	signingkey = /Users/uzimaru/.ssh/id_git_sign
[core]
	editor = nvim
	pager = delta
	compression = 0
	excludesfile = /Users/uzimaru/.gitignore_global
[alias]
	ignore = "!gi() { curl -sL https://www.toptal.com/developers/gitignore/api/$@ ;}; gi"
[rerere]
	enabled = true
[interactive]
	diffFilter = delta --color-only
[delta]
	syntax-theme = Nord

[http]
	postBuffer = 500M
	maxRequestBuffer = 100M
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[gpg]
	format = ssh
[init]
	defaultBranch = main
[gpg "ssh"]
	program = /Users/uzimaru/.local/bin/ssh-sign
	allowedSignersFile = /Users/uzimaru/.config/git/allowed_signers
[includeIf "gitdir:**/.git/worktrees/"]
	path = ~/.config/git/agent-worktree.gitconfig
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
