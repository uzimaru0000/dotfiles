#!/usr/bin/env zsh

# Git Work - タスク開始用のインタラクティブツール
set -euo pipefail

# カラー定義
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly CYAN='\033[0;36m'
readonly NC='\033[0m' # No Color

# アイコン定義
readonly ICON_TASK=""
readonly ICON_BRANCH=""
readonly ICON_TYPE=""
readonly ICON_SUCCESS=""
readonly ICON_ERROR=""
readonly ICON_INFO=""

# エラーメッセージ出力
error() {
    echo -e "${RED}${ICON_ERROR} $1${NC}" >&2
    exit 1
}

# 情報メッセージ出力（標準エラー出力へ）
info() {
    echo -e "${BLUE}${ICON_INFO} $1${NC}" >&2
}

# 成功メッセージ出力（標準エラー出力へ）
success() {
    echo -e "${GREEN}${ICON_SUCCESS} $1${NC}" >&2
}

# プロンプト表示（標準エラー出力へ）
prompt() {
    echo -en "${CYAN}$1${NC}" >&2
}

# Gitリポジトリチェック
check_git_repo() {
    if ! git rev-parse --git-dir > /dev/null 2>&1; then
        error "現在のディレクトリはGitリポジトリではありません"
    fi
}

# claudeコマンドでブランチ名を生成
generate_branch_name() {
    local task_description=$1
    
    # claudeコマンドが存在するかチェック
    if ! command -v claude >/dev/null 2>&1; then
        error "claudeコマンドが見つかりません"
    fi
    
    # claudeにブランチ名を生成してもらう
    local prompt="以下のタスクに対して適切なGitブランチ名を生成してください。タスクの内容から適切なタイプ（feature/fix/refactor/docs/test/chore）を判断してください。ブランチ名のみを出力し、説明や前置きは不要です。

タスク内容: $task_description

ブランチ名の形式: タイプ/短い説明（英語、ハイフン区切り、小文字）
例: feature/add-user-auth, fix/login-error, refactor/optimize-db-query"

    # claudeの出力から制御文字を除去
    local branch_name=$(echo "$prompt" | claude 2>/dev/null | tail -1 | sed 's/\x1b\[[0-9;]*m//g' | sed 's/\x1b\][0-9]*;[^'$'\x07'']*'$'\x07''//g' | tr -d '\n\r')
    
    if [[ -z $branch_name ]]; then
        error "ブランチ名の生成に失敗しました"
    fi
    
    # ブランチ名をサニタイズ（念のため）
    branch_name=$(echo "$branch_name" | sed 's/[^a-zA-Z0-9/_-]//g')
    
    echo "$branch_name"
}

# メイン処理
main() {
    check_git_repo
    
    # タスクの説明を入力（自然言語で）
    echo -e "${YELLOW}${ICON_TASK} タスクの内容を自然言語で説明してください:${NC}" >&2
    prompt "> "
    read task_description
    
    if [[ -z $task_description ]]; then
        error "タスクの説明を入力してください"
    fi
    
    echo "" >&2
    info "claudeでブランチ名を生成中..."
    
    # ブランチ名を生成
    branch_name=$(generate_branch_name "$task_description")
    
    echo "" >&2
    info "生成されたブランチ名: $branch_name"
    
    # 確認
    echo "" >&2
    prompt "このブランチを作成してworktreeを追加しますか? (Y/n): "
    read confirm
    
    if [[ $confirm == [nN] ]]; then
        info "キャンセルされました"
        exit 0
    fi
    
    # ブランチが既に存在するかチェック
    if git show-ref --verify --quiet "refs/heads/$branch_name"; then
        error "ブランチ '$branch_name' は既に存在します"
    fi
    
    # worktreeを追加（git-wtコマンドを使用）
    info "worktreeを作成中..."
    
    # worktreeのパスを計算
    local git_root=$(git rev-parse --show-toplevel)
    local worktrees_dir="$git_root/.git/wt_dir"
    local worktree_path="$worktrees_dir/${branch_name//\//-}"
    
    # worktreeディレクトリを作成
    mkdir -p "$worktrees_dir"
    
    info "worktreeを作成中..."
    
    # 新しいブランチでworktreeを作成
    if git worktree add -b "$branch_name" "$worktree_path" >&2; then
        success "worktreeを作成しました"
        echo "" >&2
        info "タスクの詳細:"
        echo "  説明: $task_description" >&2
        echo "  ブランチ: $branch_name" >&2
        echo "  パス: $worktree_path" >&2
        # worktreeのパスを標準出力に出力（最後の行のみ）
        echo "$worktree_path"
    else
        error "worktreeの作成に失敗しました"
    fi
}

# スクリプト実行
main